NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that cron callers (Cloud Scheduler, Supabase pg_cron, n8n) send as `Authorization: Bearer ...`
CRON_SECRET=
# Only with the wp-fluentauth pack (account mode B): the WordPress login page people are sent to, https only.
WP_LOGIN_URL=
# loops-email: optional JSON map of event name to Loops transactional email id, e.g. {"app.welcome":"<id>"}
LOOPS_TRANSACTIONAL=
