NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that cron callers (Cloud Scheduler, Supabase pg_cron, n8n) send as `Authorization: Bearer ...`
CRON_SECRET=

# Optional JSON for the interview: {"needs":{tag:{pack,why}},"commercial":{tag:{name,title,why}},"external":{tag:{name,why}}}. Unset: only a need that names a catalog pack exactly selects it.
INTERVIEW_RULES=
